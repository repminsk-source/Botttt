# Telegram
BOT_TOKEN=
ADMIN_IDS=

# SQLite path (use a persistent disk or external database for production durability)
DB_PATH=gavan.db

# AI: Ollama Cloud is the primary provider
AI_PROVIDER=ollama
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:20b-cloud
OLLAMA_API_KEY=

# Optional fallback providers (used only with AI_PROVIDER=fallback)
GROK_API_KEY=
GROK_MODEL=grok-4.3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gameplay timing
ACTION_COOLDOWN_SECONDS=600
ATTACK_COOLDOWN_SECONDS=3600
COLLECT_COOLDOWN_SECONDS=2700
BUILD_COOLDOWN_SECONDS=60
UPGRADE_COOLDOWN_SECONDS=600
MOBILIZE_COOLDOWN_SECONDS=600
BUY_COOLDOWN_SECONDS=60
BASE_COOLDOWN_SECONDS=600
POLICY_COOLDOWN_SECONDS=1800
SPY_COOLDOWN_SECONDS=900
NUKE_COOLDOWN_SECONDS=3600

# Anti-spam
GLOBAL_MESSAGE_COOLDOWN_SECONDS=1.5
DUPLICATE_MESSAGE_WINDOW_SECONDS=4
SPAM_BURST_WINDOW_SECONDS=10
SPAM_BURST_LIMIT=8
